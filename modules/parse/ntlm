def run(data, cred, args):
    log_file = getattr(args, "file", None) or "/tmp/responder.out"
    out_file = getattr(args, "out", None) or "/tmp/ntlm_hashes.txt"

    print(f"[*] Parsing NTLM hashes from {log_file}")

    username = None
    hashes = []

    with open(log_file, "r") as f:
        for line in f:
            if "NTLMv2-SSP Username" in line:
                username = line.split(":", 1)[1].strip()

            elif "NTLMv2-SSP Hash" in line:
                hash_value = line.split(":", 1)[1].strip()
                hashes.append((username, hash_value))

    if not hashes:
        print("[!] No hashes found")
        return

    with open(out_file, "w") as f:
        for _, h in hashes:
            f.write(h + "\n")

    print(f"[+] Saved hashes to {out_file}")

    for user, h in hashes:
        print(f"[+] {user} : {h}")